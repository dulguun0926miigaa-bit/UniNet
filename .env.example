DATABASE_URL=postgresql://uninet:uninet-local-only@localhost:5433/uninet?schema=public
VITE_API_URL=http://localhost:4000/api
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
TICKET_SIGNING_SECRET=replace-with-a-third-independent-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_TOUCH_INTERVAL_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
PASSWORD_RESET_OTP_EXPIRES_IN=10m
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
REMEMBER_ME_DAYS=30
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_CODE_EXPIRES_IN=10m
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_SECRET=replace-with-a-dedicated-random-secret-at-least-32-characters
INVITATION_TOKEN_EXPIRES_IN=72h
# console | smtp | resend | disabled
# Student forgot password uses a Resend email OTP. Student accounts do not use Google Authenticator.
# When Node runs on Windows and Mailpit runs in Docker, use SMTP_HOST=localhost and SMTP_PORT=1025.
EMAIL_DELIVERY_MODE=console
# For local Resend testing without a verified domain use onboarding@resend.dev (recipient restrictions apply).
# For production use a sender on your verified domain.
EMAIL_FROM=no-reply@uninet.local
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_REPLY_TO=
# SMTP is required when EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
APP_URL=http://localhost:5174

# Google OAuth (disabled until credentials are supplied)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=4000
NODE_ENV=development
TRUST_PROXY=false
REDIS_URL=redis://localhost:6379
# Private object storage. Browser clients never receive these credentials.
FILE_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uninet-files
S3_ACCESS_KEY=uninet-local
S3_SECRET_KEY=uninet-local-secret
S3_FORCE_PATH_STYLE=true
FILE_CV_MAX_BYTES=5242880
FILE_AVATAR_MAX_BYTES=2097152
FILE_UNIVERSITY_LOGO_MAX_BYTES=2097152
# Use clamd outside tests/local fallback. Production rejects disabled scanning.
CLAMAV_MODE=disabled
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# Optional local-only student account. Existing accounts are never overwritten.
SEED_DEMO_USERS=false
SEED_DEMO_EMAIL=student@muis.example
SEED_DEMO_PASSWORD=replace-with-a-strong-local-password
SEED_DEMO_FIRST_NAME=Дөлгөөн
SEED_DEMO_LAST_NAME=Бат
SEED_DEMO_UNIVERSITY_SLUG=muis
SEED_DEMO_MAJOR=Програм хангамж
# Optional local-only role demo accounts for all 5 universities.
# Re-running the seed resets only these dedicated demo accounts to SEED_ROLE_PASSWORD.
SEED_ROLE_USERS=true
SEED_ROLE_PASSWORD=ChangeMe!2026Local
SEED_SUPER_ADMIN_EMAIL=superadmin@uninet.local
# Final MVP deterministic demo reset (LOCAL/TEST ONLY)
# Set this exact value only immediately before running: npm run db:demo-reset
DEMO_RESET_CONFIRM=
E2E_DEMO_PASSWORD=

# Phase 5G microservice runtime
GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4101
CORE_SERVICE_PORT=4102
GATEWAY_BIND_HOST=127.0.0.1
SERVICE_BIND_HOST=127.0.0.1
IDENTITY_SERVICE_URL=http://127.0.0.1:4101
CORE_SERVICE_URL=http://127.0.0.1:4102
GATEWAY_UPSTREAM_TIMEOUT_MS=15000
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_RESET_MS=30000

# Phase 5I MFA / step-up / login security
# Production дээр JWT secret-үүдээс өөр random 32+ тэмдэгт secret ашиглана.
MFA_CHALLENGE_SECRET=uninet-local-mfa-challenge-secret-change-before-production
# 32-byte key encoded as 64 hex characters. Example generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=UniNet
MFA_LOGIN_CHALLENGE_EXPIRES_IN=10m
MFA_SETUP_EXPIRES_IN=10m
STEP_UP_EXPIRES_IN=10m
PASSWORD_HISTORY_COUNT=5
LOGIN_BACKOFF_THRESHOLD=3
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_ALERT_THRESHOLD=5
EMAIL_CHANGE_TOKEN_EXPIRES_IN=30m

# Stripe TEST/SANDBOX paid-event checkout. Keep secrets only in this backend .env file.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
