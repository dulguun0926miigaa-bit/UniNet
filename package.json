{
  "name": "uninet-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "overrides": {
    "@prisma/dev": {
      "find-my-way": "9.7.0",
      "valibot": "1.4.2"
    },
    "brace-expansion": "5.0.8"
  },
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "server:dev": "node scripts/run-services.mjs --watch",
    "server:start": "node scripts/run-services.mjs",
    "build": "vite build",
    "docs:check": "node scripts/check-doc-links.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:email-verification-smoke": "node scripts/email-verification-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "type-check": "tsc -p tsconfig.server.json",
    "ci:quality": "npm run db:generate && npm run lint && npm run type-check && npm run docs:check && npm run test:coverage && npm run build && npm run security:licenses && npm run security:sbom",
    "security:audit": "npm audit --audit-level=moderate",
    "docker:config": "docker compose config --quiet",
    "docker:build": "docker compose build",
    "docker:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-build.ps1",
    "test:mvp-backend-smoke": "node scripts/mvp-backend-smoke.mjs",
    "test:mvp-backend-behavior": "node scripts/mvp-backend-behavior-smoke.mjs",
    "test:phase3-smoke": "node scripts/phase3-frontend-rate-limit-smoke.mjs",
    "test:phase4-smoke": "node scripts/phase4-ui-polish-smoke.mjs",
    "test:phase5a-smoke": "node scripts/phase5a-pending-student-review-smoke.mjs",
    "test:phase5b-smoke": "node scripts/phase5b-survey-backend-smoke.mjs",
    "test:phase5c-smoke": "node scripts/phase5c-demo-export-ui-smoke.mjs",
    "test:phase5d-smoke": "node scripts/phase5d-registration-application-resend-smoke.mjs",
    "db:demo-reset": "node scripts/reset-demo.mjs",
    "test:phase5e-smoke": "node scripts/phase5e-final-mvp-smoke.mjs",
    "test:phase5e1-smoke": "node scripts/phase5e1-direct-student-approval-smoke.mjs",
    "test:phase5f-smoke": "node scripts/phase5f-ux-oauth-realtime-operations-smoke.mjs",
    "services:dev": "node scripts/run-services.mjs --watch",
    "services:start": "node scripts/run-services.mjs",
    "test:phase5g-smoke": "node scripts/phase5g-oauth-dropdown-microservices-smoke.mjs",
    "server:monolith:dev": "node --watch server/src/server.js",
    "server:monolith:start": "node server/src/server.js",
    "security:licenses": "node scripts/check-licenses.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "security:supply-chain": "npm run security:licenses && npm run security:sbom && npm run security:audit",
    "test:phase5h-smoke": "node scripts/phase5h-checklist-closure-smoke.mjs",
    "test:phase5i-smoke": "node scripts/phase5i-security-mfa-step-up-smoke.mjs",
    "dev:network": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "test:phase5j-smoke": "node scripts/phase5j-authenticator-event-qr-profile-smoke.mjs",
    "test:phase5k-smoke": "node scripts/phase5k-authenticator-ticket-stability-ui-smoke.mjs",
    "test:phase5l-smoke": "node scripts/phase5l-direct-authenticator-admin-actions-smoke.mjs",
    "test:phase5m-smoke": "node scripts/phase5m-resend-remember-stripe-smoke.mjs"
  },
  "prisma": {
    "seed": "node server/prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@zxing/browser": "0.1.5",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "file-type": "22.0.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "multer": "2.2.0",
    "nodemailer": "9.0.3",
    "pg": "^8.22.0",
    "qrcode": "1.5.4",
    "rate-limit-redis": "6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.22",
    "prisma": "7.9.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
